# docker compose'un DEĞİŞKEN İNTERPOLASYON kaynağı (--env-file ile verilir).
#
#   cp deploy/prod.env.example deploy/prod.env && chmod 600 deploy/prod.env
#
# NEDEN AYRI DOSYA: docker compose varsayılan olarak proje kökündeki `.env`i
# okur — ama o dosya Symfony'nin commit'li `.env`i ve içinde APP_ENV=dev var.
# Onunla çalıştırılırsa prod konteyneri dev ortamıyla açılır. --env-file
# vererek o dosyayı tamamen devre dışı bırakıyoruz.

# --- Symfony ---------------------------------------------------------------
APP_ENV=prod
# ZORUNLU: 32 baytlık rastgele onaltılık dize. Üret:
#   openssl rand -hex 32
APP_SECRET=DEGISTIR_openssl_rand_hex_32

# --- MySQL -----------------------------------------------------------------
MYSQL_VERSION=8.4
MYSQL_DATABASE=whatsapp_messenger
MYSQL_USER=app
# ZORUNLU: güçlü parola. Üret:  openssl rand -base64 24
MYSQL_PASSWORD=DEGISTIR_guclu_parola
MYSQL_ROOT_PASSWORD=DEGISTIR_guclu_root_parolasi

# --- Ağ / sistem -----------------------------------------------------------
# TLS kullanılıyorsa (compose.tls.yaml) bu değer YOK SAYILIR; o dosya
# ports'u !override ile 80+443 olarak yeniden yazar.
HTTP_PORT=80
TZ=Europe/Istanbul
