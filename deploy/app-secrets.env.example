# php konteynerine env_file ile enjekte edilen uygulama değişkenleri.
#
#   cp deploy/app-secrets.env.example deploy/app-secrets.env && chmod 600 deploy/app-secrets.env
#
# NEDEN GEREKLİ: prod'da bind mount YOK ve `.env.local` .dockerignore'da —
# yani dev'de çalışan gizli anahtarlar prod imajına hiç ulaşmaz. Bu dosya
# olmadan ilk WhatsApp gönderimi patlar.
#
# BİÇİM: değerleri tırnaksız yaz, satır sonuna yorum ekleme (docker compose
# env_file'ı kabuk gibi ayrıştırmaz).
# DATABASE_URL buraya YAZILMAZ — compose.yaml onu MYSQL_* değişkenlerinden
# kuruyor ve `environment:` her zaman `env_file:`i ezer.

# --- WhatsApp Cloud API ----------------------------------------------------
# Meta Business > System Users üzerinden alınmış KALICI token olmalı; geçici
# kullanıcı token'ı 60 günde biter ve pilot ortasında gönderim durur.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Meta webhook doğrulaması için kendi belirlediğin rastgele gizli metin
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard > Settings > Basic > App Secret (gelen imza doğrulaması)
META_APP_SECRET=

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uygulama bayrakları ---------------------------------------------------
# "1" ise gelen yanıtlar karar ağacına (WebhookYanitRouter) yönlendirilir.
PILOT_KARAR_AGACI_AKTIF=0
